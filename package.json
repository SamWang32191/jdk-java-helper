{
  "name": "jdk-auto-switch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pack:check": "npm run pack:check --workspaces --if-present",
    "release:version-check": "node ./scripts/release-version-check.mjs",
    "release:check": "npm run build && npm test && npm run release:version-check && npm run pack:check",
    "release:publish": "node ./scripts/publish-workspaces.mjs",
    "release:publish:dry-run": "node ./scripts/publish-workspaces.mjs --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.9"
  }
}
