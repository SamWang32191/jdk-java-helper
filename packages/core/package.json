{
  "name": "@jdk-auto-switch/core",
  "version": "0.1.0",
  "description": "Core JDK resolution library and CLI for Maven-aware command execution.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jdk-auto-switch": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --minify --clean",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test && npm run pack:check",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0"
  }
}
