{
  "name": "@w32191/jdk-auto-switch-opencode-plugin",
  "version": "0.1.0",
  "description": "OpenCode plugin for command-scoped JDK switching in Maven projects.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "oc-plugin": [
    "server"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test && npm run pack:check",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@w32191/jdk-auto-switch-core": "0.1.0",
    "@opencode-ai/plugin": "1.3.13"
  }
}
